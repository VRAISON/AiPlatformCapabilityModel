{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model.schema.json",
  "title": "AI Platform Capability Model",
  "description": "A product-neutral capability model of AI agent platforms in three tiers (Capability Area, Capability, Service), with an architectural profile per service and evidence of which reviewed platforms exhibit it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "generated",
    "license",
    "actors",
    "platforms",
    "areas"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Relative reference to this schema file."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Name of the model."
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+$",
      "description": "Model version, for example v3."
    },
    "generated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Date the evidence was reviewed and the model generated (ISO 8601 date)."
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "License of the data, for example CC BY 4.0."
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "External actors allowed as interface sources or targets that are not services in the model.",
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "Actor name, for example User or Model provider."
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "description": "The platforms whose homes, protocols, and flags were reviewed for evidence.",
      "items": {
        "$ref": "#/$defs/platform"
      }
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "description": "Tier 1: Capability Areas.",
      "items": {
        "$ref": "#/$defs/area"
      }
    }
  },
  "$defs": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "description": "One reviewed platform.",
      "required": [
        "code",
        "name",
        "kind",
        "vendor",
        "home",
        "version",
        "auth",
        "model",
        "note"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][a-z]$",
          "description": "Two-letter platform code used in evidence strings and coverage, for example Cx."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Product name."
        },
        "kind": {
          "type": "string",
          "enum": [
            "client",
            "host"
          ],
          "description": "client: an agent client. host: a local model runtime with no session, grant, or memory service."
        },
        "vendor": {
          "type": "string",
          "minLength": 1,
          "description": "Vendor of the product."
        },
        "home": {
          "type": "string",
          "minLength": 1,
          "description": "The home directory or store that was reviewed."
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Version observed, or \"not recorded\"."
        },
        "auth": {
          "type": "string",
          "minLength": 1,
          "description": "Authentication method."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Default model, or \"not recorded\"."
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "Short summary of what the home contains."
        }
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "description": "Tier 1: a Capability Area, a broad concern every agent platform has.",
      "required": [
        "id",
        "name",
        "slug",
        "description",
        "capabilities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BA[0-9]+$",
          "description": "Position-based area id, for example BA1."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Area name."
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "URL-safe form of the name."
        },
        "description": {
          "type": "string",
          "pattern": "^Ability to ",
          "description": "An \"Ability to [action] [object] [context]\" statement."
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "description": "What the area includes and what it leaves to a neighbor."
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "description": "Tier 2: the capabilities in this area.",
          "items": {
            "$ref": "#/$defs/capability"
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "description": "Tier 2: a Capability, an ability the platform must have inside its area.",
      "required": [
        "id",
        "name",
        "slug",
        "description",
        "services"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BA[0-9]+\\.[0-9]{2}$",
          "description": "Position-based capability id: area id, dot, two-digit position, for example BA1.01."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Capability name."
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "URL-safe form of the name."
        },
        "description": {
          "type": "string",
          "pattern": "^Ability to ",
          "description": "An \"Ability to [action] [object] [context]\" statement."
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "description": "What the capability includes and excludes."
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "The role or team that owns the capability."
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "description": "Tier 3: the services that deliver this capability.",
          "items": {
            "$ref": "#/$defs/service"
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "description": "Tier 3: a Service, one functional pattern applied to one asset.",
      "required": [
        "id",
        "name",
        "slug",
        "pattern",
        "asset",
        "prevalence",
        "evidence",
        "description",
        "platforms",
        "profile"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BA[0-9]+\\.[0-9]{2}\\.[0-9]{2}$",
          "description": "Position-based service id: capability id, dot, two-digit position, for example BA1.01.03."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Service name, unique in the model."
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "URL-safe form of the name, unique in the model."
        },
        "pattern": {
          "type": "string",
          "enum": [
            "Direct",
            "Manage",
            "Administer",
            "Design",
            "Provision",
            "Fulfill",
            "Operate",
            "Maintain",
            "Track",
            "Monitor",
            "Analyze",
            "Register",
            "Agree",
            "Assess",
            "Allocate",
            "Process"
          ],
          "description": "The functional pattern: what is done."
        },
        "asset": {
          "type": "string",
          "minLength": 1,
          "description": "The asset: what the pattern is done to. Never equal to the service name."
        },
        "prevalence": {
          "type": "string",
          "enum": [
            "wide",
            "mixed",
            "rare",
            "host",
            "open"
          ],
          "description": "wide: most clients store or expose it. mixed: several clients, different shapes. rare: one or two clients. host: the model runtime. open: in the product class, but no home or protocol evidences it."
        },
        "evidence": {
          "type": "string",
          "description": "Evidence string: platform codes with file paths, tables, flags, or protocol messages. Empty or descriptive for open services."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "One-sentence definition of the service."
        },
        "platforms": {
          "type": "array",
          "uniqueItems": true,
          "description": "Codes of the platforms that exhibit the service. Empty when prevalence is open. Binary presence, not quality.",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][a-z]$",
            "description": "A platform code from platforms[].code."
          }
        },
        "profile": {
          "$ref": "#/$defs/profile"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "description": "The five-section architectural profile of a service.",
      "required": [
        "inside",
        "excludes",
        "purpose",
        "functions",
        "entities",
        "inbound",
        "outbound",
        "security",
        "storage",
        "performance"
      ],
      "properties": {
        "inside": {
          "type": "string",
          "minLength": 1,
          "description": "Section 1, bounded context: what is inside the service."
        },
        "excludes": {
          "type": "string",
          "minLength": 1,
          "description": "Section 1, bounded context: what the service leaves to named neighbors."
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "description": "Section 1: why the service exists."
        },
        "functions": {
          "type": "array",
          "minItems": 1,
          "description": "Section 2, functional capabilities: [name, description] pairs.",
          "items": {
            "type": "array",
            "description": "One function.",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1,
                "description": "Function name."
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "What it does."
              }
            ],
            "items": false,
            "minItems": 2
          }
        },
        "entities": {
          "type": "array",
          "minItems": 1,
          "description": "Section 3, core domain entities: [name, definition] pairs.",
          "items": {
            "type": "array",
            "description": "One entity.",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1,
                "description": "Entity name."
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "Definition and attributes."
              }
            ],
            "items": false,
            "minItems": 2
          }
        },
        "inbound": {
          "type": "array",
          "minItems": 1,
          "description": "Section 4, interfaces consumed: [source, mechanism, purpose]. Source is a service name or an actor.",
          "items": {
            "type": "array",
            "description": "One inbound interface.",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1,
                "description": "Source service or actor."
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "Mechanism."
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "Purpose."
              }
            ],
            "items": false,
            "minItems": 3
          }
        },
        "outbound": {
          "type": "array",
          "minItems": 1,
          "description": "Section 4, interfaces exposed: [target, mechanism, data]. Target is a service name or an actor.",
          "items": {
            "type": "array",
            "description": "One outbound interface.",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1,
                "description": "Target service or actor."
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "Mechanism."
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "Data or trigger."
              }
            ],
            "items": false,
            "minItems": 3
          }
        },
        "security": {
          "type": "string",
          "minLength": 1,
          "description": "Section 5, quality constraint: security."
        },
        "storage": {
          "type": "string",
          "minLength": 1,
          "description": "Section 5, quality constraint: storage."
        },
        "performance": {
          "type": "string",
          "minLength": 1,
          "description": "Section 5, quality constraint: performance."
        }
      }
    }
  }
}
